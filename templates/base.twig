<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Reservas API{% endblock %}</title>
    <link rel="stylesheet" href="/reservas-api/public/assets/css/app.css">
</head>
<body>
    <header>
        <h1>Gestión de Reservas</h1>
        <nav>
            <a href="/reservas_api/public/reservas">Listado</a> |
            <a href="/reservas_api/public/reservas/crear">Nueva reserva</a>
        </nav>
        <hr>
    </header>

    <main>
        {% block content %}{% endblock %}
    </main>

    <footer>
        <hr>
        <small>Prueba técnica — API de reservas</small>
    </footer>

    {% block scripts %}{% endblock %}
    <script src="/reservas_api/public/assets/js/app.js"></script>
</body>
</html>
