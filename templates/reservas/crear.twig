{% extends 'base.twig' %}

{% block title %}Nueva Reserva{% endblock %}

{% block content %}
    <h2>Nueva Reserva</h2>
    <p><a href="/reservas_api/public/reservas">&larr; Volver al listado</a></p>

    <form id="form-crear-reserva">
        <div style="margin-bottom: 10px;">
            <label>Nombre Huésped:<br> <input type="text" name="nombre_huesped" required></label>
        </div>
        <div style="margin-bottom: 10px;">
            <label>Email:<br> <input type="email" name="email_huesped" required></label>
        </div>
        <div style="margin-bottom: 10px;">
            <label>Alojamiento:<br> <input type="text" name="nombre_alojamiento" required></label>
        </div>
        <div style="margin-bottom: 10px;">
            <label>Entrada:<br> <input type="date" name="fecha_entrada" required></label>
        </div>
        <div style="margin-bottom: 10px;">
            <label>Salida:<br> <input type="date" name="fecha_salida" required></label>
        </div>
        <div style="margin-bottom: 10px;">
            <label>Importe (€):<br> <input type="number" step="0.01" name="importe" required></label>
        </div>
        <div style="margin-bottom: 10px;">
            <label>Notas:<br> <textarea name="notas"></textarea></label>
        </div>
        <button type="submit">Crear Reserva</button>
    </form>
    
    <div id="mensaje-error" style="color: red; margin-top: 10px; display: none;"></div>
{% endblock %}